# ==============================================================================
# Vision-Based Assistive Perception System - Backend Configuration Template
# ------------------------------------------------------------------------------
# Copy this file to .env and configure values before starting services.
# DO NOT COMMIT ACTUAL API KEYS OR CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Application Environment
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Cross-Origin Resource Sharing (CORS) - JSON array format
ALLOWED_ORIGINS=["*"]

# --- Google Gemini Vision-Language Model Configuration ---
# Generate an API key from Google AI Studio: https://aistudio.google.com/
# Leave empty to run with local MockVisionProvider for offline development/testing
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=15.0

# --- Future Service Credential Placeholders ---
# Translation Service Configuration (To be configured in future phase)
TRANSLATION_PROVIDER=placeholder
TRANSLATION_API_KEY=

# Text-to-Speech (TTS) Provider Configuration (To be configured in future phase)
TTS_PROVIDER=placeholder
TTS_API_KEY=
